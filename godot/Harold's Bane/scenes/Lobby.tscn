[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://nodes/lobby_ui.gd" id="1_lobby"]

[sub_resource type="LabelSettings" id="LabelSettings_title"]
font_size = 32

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
text = "Harold's Bane"
label_settings = SubResource("LabelSettings_title")
horizontal_alignment = 1

[node name="AddressLabel" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
text = "Server address (for joining):"

[node name="AddressInput" type="LineEdit" parent="CenterContainer/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "127.0.0.1"
placeholder_text = "e.g. 192.168.1.42"

[node name="HostButton" type="Button" parent="CenterContainer/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "HOST GAME"

[node name="JoinButton" type="Button" parent="CenterContainer/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "JOIN GAME"

[node name="StatusLabel" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = ""
horizontal_alignment = 1

[connection signal="pressed" from="CenterContainer/Panel/Margin/VBox/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="CenterContainer/Panel/Margin/VBox/JoinButton" to="." method="_on_join_pressed"]