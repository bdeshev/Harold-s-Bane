# Godot 4+ specific ignores
.godot/
/android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Python bytecode (tooling scripts)
__pycache__/
*.py[cod]

# Krita/GIMP/Photoshop working files
# Keep sources in a separate repo or LFS if needed; Godot never imports them
*.xcf
*.kra
*.psd

# System/tool junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
